          "description": "Contract bundle version (major must match 2.x.x of the frozen contracts)."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Stable identifier, e.g. \"claim-tool-catalog-1\"."
        },
        "kind": {
          "type": "string",
          "enum": [
            "uses",
            "part-of",
            "depends-on",
            "integrates-with",
            "alternative-to",
            "produces",
            "manages",
            "secures",
            "monitors",
            "contrasts-with",
            "related-to",
            "other"
          ],
          "description": "Directed relationship kind."
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Subject entity id."
        },
        "objectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Object entity id."
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Human phrase for the directed predicate, e.g. \"alternative hosted form of\"."
        },
        "evidence": {
          "readOnly": true,
          "description": "Evidence spans supporting the relationship. Multi-span evidence means co-occurrence support (the spans jointly ground the relationship).",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "description": "Id of the SourceArtifact this span indexes into."
              },
              "blockId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "description": "Id of the SourceBlock containing the span."
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Inclusive start offset in UTF-16 code units into the source text."
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Exclusive end offset in UTF-16 code units."
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "description": "Exact quoted substring; must equal source.text.slice(start, end)."
              }
            },
            "required": [
              "sourceId",
              "blockId",
              "start",
              "end",
              "quote"
            ],
            "additionalProperties": false,
            "title": "EvidenceSpan",
            "description": "An exact evidence quote plus offsets into the source text.",
            "$ref": "#/$defs/EvidenceSpan"
          }
        },
        "claimIds": {
          "readOnly": true,
          "description": "Claims that assert this relationship.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
