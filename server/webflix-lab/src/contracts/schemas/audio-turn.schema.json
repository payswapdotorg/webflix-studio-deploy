{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webflix-lab.dev/contracts/audio-turn.schema.json",
  "type": "object",
  "properties": {
    "recordType": {
      "type": "string",
      "const": "AudioTurn"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^2\\.\\d+\\.\\d+$",
      "description": "Contract bundle version (major must match 2.x.x of the frozen contracts)."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier, e.g. \"claim-tool-catalog-1\"."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Zero-based position in the turn sequence."
    },
    "speaker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Display name, e.g. \"Host A\"."
    },
    "speakerRole": {
      "type": "string",
      "enum": [
        "host-a",
        "host-b",
        "guest",
        "narrator"
      ],
      "description": "Dialogue role of the speaker."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "framing",
        "question",
        "explanation",
        "example",
        "connection",
        "clarification",
        "interjection",
        "transition",
        "synthesis",
        "conclusion"
      ],
      "description": "Editorial purpose of the turn in the dialogue graph."
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Plan-level directive: what this turn must accomplish and stay grounded on."
    },
    "text": {
      "description": "Final narration script; filled by the audio compiler, absent at plan level.",
      "type": "string",
      "maxLength": 8000
    },
    "claimIds": {
      "readOnly": true,
      "description": "Grounded claims this turn draws on.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "description": "Stable identifier, e.g. \"claim-tool-catalog-1\"."
      }
    },
    "evidence": {
      "readOnly": true,
      "description": "Primary evidence backing this turn (usually the top span per claim).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Id of the SourceArtifact this span indexes into."
          },
          "blockId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Id of the SourceBlock containing the span."
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Inclusive start offset in UTF-16 code units into the source text."
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Exclusive end offset in UTF-16 code units."
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "description": "Exact quoted substring; must equal source.text.slice(start, end)."
          }
        },
        "required": [
          "sourceId",
          "blockId",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false,
        "title": "EvidenceSpan",
        "description": "An exact evidence quote plus offsets into the source text.",
        "$ref": "#/$defs/EvidenceSpan"
      }
    },
    "beatId": {
      "description": "Narrative beat this turn belongs to.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "style": {
      "description": "Provider-neutral delivery style for one turn.",
      "$ref": "#/$defs/TurnStyle"
    },
    "targetDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Planned duration of this turn in seconds."
    }
  },
  "required": [
    "recordType",
    "contractVersion",
    "id",
    "index",
    "speaker",
    "speakerRole",
    "purpose",
    "brief",
    "claimIds",
    "evidence",
    "style",
    "targetDurationSeconds"
  ],
  "additionalProperties": false,
  "title": "AudioTurn",
  "$defs": {
    "EvidenceSpan": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Id of the SourceArtifact this span indexes into."
        },
        "blockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Id of the SourceBlock containing the span."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Inclusive start offset in UTF-16 code units into the source text."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exclusive end offset in UTF-16 code units."
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "Exact quoted substring; must equal source.text.slice(start, end)."
        }
      },
      "required": [
        "sourceId",
        "blockId",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false,
      "title": "EvidenceSpan"
    },
    "TurnStyle": {
      "type": "object",
      "properties": {
        "delivery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Delivery direction for the speaker, e.g. \"curious question\"."
        },
        "emphasis": {
          "description": "Optional emphasis note, e.g. \"land the number precisely\".",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "delivery"
      ],
      "additionalProperties": false,
      "title": "TurnStyle"
    }
  }
}
