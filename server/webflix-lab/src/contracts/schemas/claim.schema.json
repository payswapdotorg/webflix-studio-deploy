{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webflix-lab.dev/contracts/claim.schema.json",
  "type": "object",
  "properties": {
    "recordType": {
      "type": "string",
      "const": "ClaimRecord"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^2\\.\\d+\\.\\d+$",
      "description": "Contract bundle version (major must match 2.x.x of the frozen contracts)."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier, e.g. \"claim-tool-catalog-1\"."
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "One-sentence declarative statement of the claim, grounded in evidence."
    },
    "kind": {
      "type": "string",
      "enum": [
        "fact",
        "capability",
        "goal",
        "definition",
        "opinion",
        "relation",
        "process",
        "quantity",
        "constraint",
        "other"
      ],
      "description": "Editorial kind of the claim."
    },
    "evidence": {
      "readOnly": true,
      "description": "Evidence spans supporting the statement; at least one is required.",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Id of the SourceArtifact this span indexes into."
          },
          "blockId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Id of the SourceBlock containing the span."
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Inclusive start offset in UTF-16 code units into the source text."
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Exclusive end offset in UTF-16 code units."
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "description": "Exact quoted substring; must equal source.text.slice(start, end)."
          }
        },
        "required": [
          "sourceId",
          "blockId",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false,
        "title": "EvidenceSpan",
        "description": "An exact evidence quote plus offsets into the source text.",
        "$ref": "#/$defs/EvidenceSpan"
      }
    },
    "entityIds": {
      "readOnly": true,
      "description": "Entities referenced by this claim.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "description": "Stable identifier, e.g. \"claim-tool-catalog-1\"."
      }
    },
    "topicIds": {
      "readOnly": true,
      "description": "Topics this claim belongs to.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "description": "Stable identifier, e.g. \"claim-tool-catalog-1\"."
      }
    },
    "salience": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Editorial salience in [0, 1]; used by the Director for ranking."
    },
    "negated": {
      "description": "True when the statement asserts absence or negation.",
      "type": "boolean"
    }
  },
  "required": [
    "recordType",
    "contractVersion",
    "id",
    "statement",
    "kind",
    "evidence",
    "entityIds",
    "topicIds",
    "salience"
  ],
  "additionalProperties": false,
  "title": "ClaimRecord",
  "$defs": {
    "EvidenceSpan": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Id of the SourceArtifact this span indexes into."
        },
        "blockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Id of the SourceBlock containing the span."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Inclusive start offset in UTF-16 code units into the source text."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exclusive end offset in UTF-16 code units."
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "Exact quoted substring; must equal source.text.slice(start, end)."
        }
      },
      "required": [
        "sourceId",
        "blockId",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false,
      "title": "EvidenceSpan"
    }
  }
}
