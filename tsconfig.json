{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@vendor/*": [
        "./server/webflix-lab/*"
      ]
    }
  },
  // NOTE: only the adapter app + the studio entry files are included directly;
  // the vendored src/ import closure is type-checked transitively. Unreferenced
  // vendored modules (video compositor etc., which import remotion) are not
  // part of the studio request path and are intentionally not checked here.
  // scripts/** are bun-side prepare-time tools (bun strips types; no tsc).
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/webflix-lab/apps/studio/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
